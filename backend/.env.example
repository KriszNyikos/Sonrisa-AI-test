# Backend Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration (SQLite file-based via alpine/sqlite container)
DATABASE_PATH=/data/alerts.db

# Email Configuration (Nodemailer)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@alertsystem.local

# Slack Configuration
SLACK_WEBHOOK_BASE_URL=https://hooks.slack.com/services

# API Configuration
API_BASE_URL=http://localhost
API_PORT=3001

